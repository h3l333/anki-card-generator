{
  "manifest_version": 3,
  "name": "Anki Tool v2 - Quick Export",
  "version": "0.1.0",
  "description": "Paste a Japanese word, generate a card, and export it to Anki automatically. No review step - use the full web app for that.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["notifications", "storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://localhost:8080/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
